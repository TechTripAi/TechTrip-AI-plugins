# techtrip-claude-plugins is a Claude Code plugin marketplace (skills, docs, one stdlib Python script).

# System
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Claude Code local state (per-user, never shared)
.claude/settings.local.json

# skill-creator eval runs (evals.json is tracked; run output is not)
plugins/*/skills/*/evals/runs/

# Local secrets / env
.env
.env.local

# Private keys and credentials (defense-in-depth; never commit these)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
credentials*
secrets.y*ml
auth.json

# Local scratch workspaces
*-workspace/

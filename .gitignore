# TechTrip-AI-plugins is a Claude Code plugin marketplace (skills, docs, one stdlib Python script).

# System
.DS_Store
._*
Thumbs.db

# IDE / editors
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Claude Code local state (per-user, never shared)
.claude/settings.local.json
.claude/*.local.json

# skill-creator eval runs (evals.json is tracked; run output is not)
plugins/*/skills/*/evals/runs/
plugins/*/skills/*/evals/*.log

# Scratch output
*.log
*.tmp

# Local secrets / env
.env
.env.*

# Private keys and credentials (defense-in-depth; never commit these)
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
credentials*
secrets.y*ml
auth.json

# Local scratch workspaces
*-workspace/
